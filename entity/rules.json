{
 "game": "zer0-g",
 "kind": "machine",
 "title": "ZER0-G machine",
 "budget": 9,
 "spec": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A ZER0-G machine",
  "type": "object",
  "additionalProperties": false,
  "required": [
   "name",
   "pilot",
   "stats",
   "weight",
   "accent",
   "flame",
   "particle"
  ],
  "properties": {
   "name": {
    "type": "string",
    "minLength": 2,
    "maxLength": 32,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9 .'!&-]{1,31}$"
   },
   "description": {
    "type": "string",
    "maxLength": 300
   },
   "pilot": {
    "type": "string",
    "minLength": 2,
    "maxLength": 16,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9 .'-]{1,15}$"
   },
   "stats": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "body",
     "boost",
     "grip"
    ],
    "properties": {
     "body": {
      "enum": [
       "A",
       "B",
       "C",
       "D",
       "E"
      ],
      "x-cost": {
       "each": {
        "A": 4,
        "B": 3,
        "C": 2,
        "D": 1,
        "E": 0
       }
      },
      "description": "how much a hit costs it and how hard it shoves others"
     },
     "boost": {
      "enum": [
       "A",
       "B",
       "C",
       "D",
       "E"
      ],
      "x-cost": {
       "each": {
        "A": 4,
        "B": 3,
        "C": 2,
        "D": 1,
        "E": 0
       }
      },
      "description": "how strong and how long its nitro burns"
     },
     "grip": {
      "enum": [
       "A",
       "B",
       "C",
       "D",
       "E"
      ],
      "x-cost": {
       "each": {
        "A": 4,
        "B": 3,
        "C": 2,
        "D": 1,
        "E": 0
       }
      },
      "description": "how sharply it turns and how little it slides"
     }
    }
   },
   "weight": {
    "type": "integer",
    "minimum": 700,
    "maximum": 1700
   },
   "accent": {
    "type": "string",
    "pattern": "^#[0-9a-fA-F]{6}$"
   },
   "flame": {
    "type": "string",
    "pattern": "^#[0-9a-fA-F]{6}$"
   },
   "particle": {
    "enum": [
     "spark",
     "star",
     "heart",
     "bolt",
     "ring",
     "note",
     "diamond",
     "snout"
    ]
   },
   "thrusters": {
    "type": "array",
    "minItems": 1,
    "maxItems": 4,
    "items": {
     "type": "array",
     "minItems": 4,
     "maxItems": 4,
     "items": {
      "type": "number",
      "minimum": -6,
      "maximum": 6
     }
    }
   }
  }
 },
 "assets": {
  "model": "required",
  "picture": "required",
  "maxSize": 6,
  "triangles": 15000
 },
 "art": "A 1990s arcade anti-gravity racing machine: neon, chrome and bold colour, a clear silhouette from behind, hovering (no wheels on the road). Original designs only: no machines, names, logos or lookalikes from other games, films or brands. No weapons, gore, sexual design or hate symbols. Model: one textured machine, nose towards +Z, resting on y = 0, one to four round exhaust nozzles at the back facing straight back. Picture: a portrait of the pilot, square, head and shoulders, in the style of a 1990s cyberpunk anime character select, on a dark neon background, no text or frame."
}
